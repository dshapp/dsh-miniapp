{
  "name": "dsh-miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "DeepSeek Harness 微信小程序端",
  "templateInfo": {
    "name": "react-NutUI",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "taro build --type weapp --watch",
    "build:h5": "taro build --type h5",
    "dev:h5": "taro build --type h5 --watch",
    "lint": "tsc --noEmit --skipLibCheck",
    "test": "node --import ./scripts/test/loader.mjs --test scripts/test/*.test.ts",
    "verify:tunnel": "node scripts/verify-tunnel.mjs"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@nutui/nutui-react-taro": "^3.0.19",
    "@tarojs/components": "^4.1.11",
    "@tarojs/helper": "^4.1.11",
    "@tarojs/plugin-framework-react": "^4.1.11",
    "@tarojs/plugin-html": "^4.1.11",
    "@tarojs/plugin-platform-h5": "^4.1.11",
    "@tarojs/plugin-platform-weapp": "^4.1.11",
    "@tarojs/react": "^4.1.11",
    "@tarojs/runtime": "^4.1.11",
    "@tarojs/shared": "^4.1.11",
    "@tarojs/taro": "^4.1.11",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/preset-react": "^7.28.5",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@tarojs/cli": "^4.1.11",
    "@tarojs/taro-loader": "^4.1.11",
    "@tarojs/webpack5-runner": "^4.1.11",
    "@types/react": "^18.3.28",
    "@types/webpack-env": "^1.18.8",
    "babel-plugin-import": "^1.13.8",
    "babel-preset-taro": "^4.1.11",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.9.3",
    "webpack": "^5"
  }
}
